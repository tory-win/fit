{
  "name": "ipfit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:linked": "vite --host 127.0.0.1 --port 15174 --strictPort",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "build:real": "VITE_APP_ENV=real tsc -b && VITE_APP_ENV=real vite build --mode real",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "ios:sync": "npm run build && cap sync ios",
    "ios:device": "node scripts/ios-device.mjs",
    "ios:device:real": "OJJEOM_ENV=real node scripts/ios-device.mjs",
    "ios:live": "node scripts/ios-live.mjs",
    "ios:linked": "node scripts/ios-linked.mjs",
    "linked:status": "node scripts/linked-status.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor-community/camera-preview": "^8.0.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.26.0",
    "lunar-javascript": "^1.7.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
